# ImpleGym Environment Configuration

# Application Server
PORT=8000
HOST=127.0.0.1
DEBUG=true

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/implegym

# Fallback test database URL for local tests without postgres
TEST_DATABASE_URL=sqlite+aiosqlite:///:memory:

# OpenAI API Key (for code refinement and custom problem synthesis)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Compilers & Toolchain
DEFAULT_CPP_COMPILER=g++
DEFAULT_CPP_STANDARD=c++20
DEFAULT_COMPILER_FLAGS=-O3 -Wall -Wextra

# Library Checker Problems Repository Path (optional local override)
YOSUPO_PROBLEMS_DIR=
